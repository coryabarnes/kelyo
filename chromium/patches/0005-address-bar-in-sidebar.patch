+namespace {
+
+// Space between Kelyo's two toolbar rows, and around the address bar row.
+constexpr int kKelyoAddressRowGap = 6;
+
+bool IsInKelyoSidebar(const views::View* toolbar) {
+  return toolbar->GetProperty(kKelyoToolbarInSidebarKey);
+}
+
+}  // namespace
+
+void ToolbarView::AfterPropertyChange(const void* key, int64_t old_value) {
+  AccessiblePaneView::AfterPropertyChange(key, old_value);
+  if (key != kKelyoToolbarInSidebarKey) {
+    return;
+  }
+  // In the sidebar the toolbar shows the sidebar's background (and Kelyo's
+  // gradient theme) rather than the toolbar colour.
+  if (display_mode_ == DisplayMode::kNormal && background()) {
+    auto* corners_background =
+        static_cast<CustomCornersBackground*>(background());
+    if (IsInKelyoSidebar(this)) {
+      corners_background->SetPrimaryColor(CustomCornersBackground::FrameTheme());
+    } else {
+      corners_background->SetPrimaryColor(
+          CustomCornersBackground::ToolbarTheme());
+    }
+    SchedulePaint();
+  }
+  // In the sidebar the address bar gets its own row, so the buttons' flex
+  // layout leaves it out and Layout() places it below them.
+  if (location_bar_view_) {
+    location_bar_view_->SetProperty(views::kViewIgnoredByLayoutKey,
+                                    IsInKelyoSidebar(this));
+  }
+  if (initialized_ && display_mode_ == DisplayMode::kNormal) {
+    LayoutCommon();
+  }
+  InvalidateLayout();
+  PreferredSizeChanged();
+}
