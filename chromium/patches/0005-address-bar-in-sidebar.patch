+std::vector<views::FrameButton> KelyoLeadingButtons() {
+  auto* const provider = views::WindowButtonOrderProvider::GetInstance();
+  std::vector<views::FrameButton> all = provider->leading_buttons();
+  all.insert(all.end(), provider->trailing_buttons().begin(),
+             provider->trailing_buttons().end());
+  std::vector<views::FrameButton> ordered;
+  for (auto button : {views::FrameButton::kClose, views::FrameButton::kMinimize,
+                      views::FrameButton::kMaximize}) {
+    if (std::ranges::find(all, button) != all.end()) {
+      ordered.push_back(button);
+    }
+  }
+  return ordered;
+}
